# Ollama-compatible chat endpoint and model.
AIMS2_MODEL_API_URL=http://localhost:11434/api/
AIMS2_MODEL=gemma4:12b
AIMS2_KEEP_ALIVE=5m
AIMS2_HTTP_TIMEOUT=2m

# Optional Ollama web-search integration.
AIMS2_WEB_SEARCH_API_URL=https://ollama.com/api/web_search
OLLAMA_API_KEY=

# Local inventory files. These must not be committed.
AIMS2_INVENTORY_DB_PATH=./importer/inventory.db
AIMS2_INVENTORY_IMPORT_PATH=
AIMS2_EXCLUDED_VENDOR_CODES=

# Conversation logging is disabled when this is empty. Logs may contain
# confidential prompts, tool arguments, prices, costs, and inventory data.
AIMS2_CONVERSATION_LOG=

# Development-only. Enabling this prints complete model requests and responses.
AIMS2_DEBUG_MODEL_PAYLOADS=false
